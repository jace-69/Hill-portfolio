---
// src/components/SocialProof.astro

const stats = [
  {
    label: 'Matters Advised',
    value: '$100bn+',
    delay: '0ms',
  },
  {
    label: 'Global Offices',
    value: '3',
    delay: '100ms',
  },
  {
    label: 'Jurisdictions Covered',
    value: '15+',
    delay: '200ms',
  },
];
---

<section id="by-the-numbers" class="bg-[#f7f6f3] py-28 sm:py-36 text-[#111111]">
  <div class="max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Title & Subtitle -->
      <div class="lg:col-span-5 flex flex-col justify-between h-full pt-1 reveal-on-scroll">
        <div class="space-y-36 flex flex-col justify-between h-full">
          <h2 class="font-serif text-4xl sm:text-5xl lg:text-[3.25rem] font-normal text-[#111111] tracking-tight">
            By the Numbers
          </h2>

          <p class="text-xs sm:text-[13.5px] text-[#555555] font-light leading-relaxed max-w-xs">
            Trusted on defining matters across borders,<br class="hidden sm:inline" />
            markets and generations.
          </p>
        </div>
      </div>

      <!-- Right Column: Number Rows with Dividing Hairlines -->
      <div class="lg:col-span-7 reveal-on-scroll" style="transition-delay: 150ms;">
        <div class="border-t border-[#dfded9]">
          {stats.map((item) => (
            <div class="py-7 sm:py-8 border-b border-[#dfded9] flex items-baseline justify-between transition-colors duration-200">
              <span class="text-xs sm:text-[13.5px] text-[#555555] font-light">
                {item.label}
              </span>

              <span class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-[#111111] tracking-tight">
                {item.value}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>