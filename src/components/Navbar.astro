---
// src/components/Navbar.astro
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-white/20 bg-black/15 backdrop-blur-[2px]">
  <div class="max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-14 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#" class="font-serif text-3xl sm:text-[34px] font-normal tracking-normal text-white hover:opacity-90 transition-opacity lowercase">
      hill
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="hidden md:flex items-center space-x-9 text-[13.5px] font-normal text-white">
      <div class="relative group">
        <button type="button" class="flex items-center gap-1.5 hover:text-white/80 transition-colors cursor-pointer">
          <span>What We Do</span>
          <svg class="w-3 h-3 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>
      <a href="#about" class="hover:text-white/80 transition-colors">About</a>
      <a href="#people" class="hover:text-white/80 transition-colors">People</a>
      <a href="#case-studies" class="hover:text-white/80 transition-colors">Case Studies</a>
      <a href="#insights" class="hover:text-white/80 transition-colors">Insights</a>
    </nav>

    <!-- Desktop Contact Button -->
    <div class="hidden md:flex">
      <a
        href="#contact"
        class="inline-block bg-white text-black hover:bg-neutral-100 text-xs font-normal py-2.5 px-6 rounded-none transition-all duration-200"
      >
        Contact
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden flex flex-col justify-center items-center w-9 h-9 space-y-1.5 focus:outline-none"
      aria-label="Toggle Navigation Menu"
    >
      <span class="w-6 h-[1.5px] bg-white transition-transform duration-300 origin-center" id="bar-1"></span>
      <span class="w-6 h-[1.5px] bg-white transition-opacity duration-300" id="bar-2"></span>
      <span class="w-6 h-[1.5px] bg-white transition-transform duration-300 origin-center" id="bar-3"></span>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="md:hidden fixed inset-0 top-[80px] bg-neutral-950/98 backdrop-blur-xl -translate-y-full opacity-0 pointer-events-none transition-all duration-300 ease-in-out px-8 py-10 flex flex-col justify-between"
  >
    <div class="flex flex-col space-y-6 text-base font-light text-neutral-200">
      <a href="#practices" class="mobile-nav-link hover:text-white transition-colors py-2 border-b border-white/10">What We Do</a>
      <a href="#about" class="mobile-nav-link hover:text-white transition-colors py-2 border-b border-white/10">About</a>
      <a href="#people" class="mobile-nav-link hover:text-white transition-colors py-2 border-b border-white/10">People</a>
      <a href="#case-studies" class="mobile-nav-link hover:text-white transition-colors py-2 border-b border-white/10">Case Studies</a>
      <a href="#insights" class="mobile-nav-link hover:text-white transition-colors py-2 border-b border-white/10">Insights</a>
    </div>

    <div class="pt-8">
      <a
        href="#contact"
        class="mobile-nav-link block text-center bg-white text-black text-xs font-medium py-3.5 px-6 w-full rounded-none"
      >
        Contact
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar-1');
  const bar2 = document.getElementById('bar-2');
  const bar3 = document.getElementById('bar-3');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    if (isOpen) {
      menu?.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
      bar1?.classList.add('rotate-45', 'translate-y-2');
      bar2?.classList.add('opacity-0');
      bar3?.classList.add('-rotate-45', '-translate-y-2');
    } else {
      menu?.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
      bar1?.classList.remove('rotate-45', 'translate-y-2');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-rotate-45', '-translate-y-2');
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    });
  });

  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      header?.classList.add('bg-neutral-950/90', 'backdrop-blur-md');
      header?.classList.remove('bg-black/15');
    } else {
      header?.classList.remove('bg-neutral-950/90', 'backdrop-blur-md');
      header?.classList.add('bg-black/15');
    }
  });
</script>